<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="hokuyo_ust_mount" params="prefix parent topic model:=ust-20 robot_name:=/  *origin">
    <joint name="${prefix}_laser_mount_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${prefix}_laser_mount" />
    </joint>

    <link name="${prefix}_laser_mount">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <!-- Origin of this mesh is the base of the bracket. -->
          <mesh filename="file://$(find urg_node)/meshes/hokuyo_ust.stl" />
        </geometry>
        <material name="dark_grey" />
      </visual>
    </link>

    <joint name="${prefix}_laser_joint" type="fixed">
      <!-- This offset is from the base of the bracket to the LIDAR's focal point. -->
      <origin xyz="0 0 0.0474" rpy="0 0 0" />
      <parent link="${prefix}_laser_mount" />
      <child link="${prefix}_laser" />
    </joint>

    <xacro:if value="${model == 'ust-10'}"> 
      <xacro:hokuyo_ust10 frame="${prefix}_laser" topic="${topic}" robot_namespace="${robot_name}"/>
    </xacro:if>
    <xacro:if value="${model == 'ust-20'}"> 
      <xacro:hokuyo_ust20 frame="${prefix}_laser" topic="${topic}" robot_namespace="${robot_name}"/>
    </xacro:if>       

    <!-- <gazebo reference="${prefix}_laser_mount">
      <material>Gazebo/DarkGrey</material>
    </gazebo> -->

  </xacro:macro>


  <!-- Define Hokuyo models -->
  <xacro:macro name="hokuyo_ust10" params="frame:=laser topic:=scan sample_size:=720 update_rate:=50 min_angle:=-2.35619 max_angle:=2.35619 min_range:=0.1 max_range:=30.0 robot_namespace:=/">
    <link name="${frame}">
      <inertial>
        <mass value="1.3" />
        <origin xyz="0 0 0" />
        <inertia ixx="${0.0833333 * 1.3 * (0.102*0.102 + 0.152*0.152)}" ixy="0.0" ixz="0.0"
                 iyy="${0.0833333 * 1.3 * (0.105*0.105 + 0.152*0.152)}" iyz="0.0"
                 izz="${0.0833333 * 1.3 * (0.105*0.105 + 0.102*0.102)}" />
      </inertial>
    </link>

    <xacro:hokuyo_laser_gazebo_v0 frame="${frame}" topic="${topic}" update_rate="50.0" sample_size="${sample_size}" min_angle="${min_angle}" max_angle="${max_angle}" min_range="${min_range}" max_range="${max_range}" robot_namespace="${robot_namespace}"/>

  </xacro:macro>

  <xacro:macro name="hokuyo_ust20" params="frame:=laser topic:=scan sample_size:=720 update_rate:=50 min_angle:=-2.35619 max_angle:=2.35619 min_range:=0.1 max_range:=60.0 robot_namespace:=/">
    <link name="${frame}">
      <inertial>
        <mass value="1.3" />
        <origin xyz="0 0 0" />
        <inertia ixx="${0.0833333 * 1.3 * (0.102*0.102 + 0.152*0.152)}" ixy="0.0" ixz="0.0"
                 iyy="${0.0833333 * 1.3 * (0.105*0.105 + 0.152*0.152)}" iyz="0.0"
                 izz="${0.0833333 * 1.3 * (0.105*0.105 + 0.102*0.102)}" />
      </inertial>
    </link>

    <xacro:hokuyo_laser_gazebo_v0 frame="${frame}" topic="${topic}" update_rate="10.0" sample_size="${sample_size}" min_angle="${min_angle}" max_angle="${max_angle}" min_range="${min_range}" max_range="${max_range}" robot_namespace="${robot_namespace}"/>

  </xacro:macro>


  <!-- TODO - Gazebo simulation -->
  <xacro:macro name="hokuyo_laser_gazebo_v0" params="frame topic update_rate sample_size min_angle max_angle min_range max_range robot_namespace:=/">
      <gazebo reference="${frame}">
        <sensor name='${frame}_sensor' type='gpu_lidar'>"
          <pose>0 0 0 0 0 0</pose>
          <gz_frame_id>${robot_name}/${frame}</gz_frame_id>
          <frame_id>${robot_name}/${frame}</frame_id>
          <topic>${robot_name}/${topic}</topic>
          <update_rate>${update_rate}</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>${sample_size}</samples>
                <resolution>1</resolution>
                <min_angle>${min_angle}</min_angle>
                <max_angle>${max_angle}</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>0.01</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
            </vertical>
            </scan>
            <range>
              <min>${min_range}</min>
              <max>${max_range}</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
          <always_on>1</always_on>
          <visualize>true</visualize>
        </sensor>
      </gazebo>
  </xacro:macro>

</robot>
